# Claude API — used by the AI Coach module and the daily WhatsApp summary
ANTHROPIC_API_KEY=sk-ant-...

# Strava OAuth — get from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Your deployed app URL (for Strava OAuth callback)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# WhatsApp delivery via CallMeBot (free, personal-use) — see README "WhatsApp Setup"
# 1. Add +34 644 51 95 23 to your phone contacts
# 2. WhatsApp it: "I allow callmebot to send me messages"
# 3. CallMeBot replies with your API key — paste it below
CALLMEBOT_PHONE=61469616917
CALLMEBOT_APIKEY=your_callmebot_apikey

# Protects /api/cron/daily-summary from being triggered by anyone who finds the URL.
# Vercel sends this automatically as a Bearer token for scheduled Cron invocations —
# generate any random string and set the same value in Vercel's env vars.
CRON_SECRET=some_random_string
